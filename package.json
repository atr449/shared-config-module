{
  "name": "@fusionxglobal/shared-config",
  "version": "1.3.1",
  "description": "Shared configuration, constants, exceptions, structured logging, OpenTelemetry tracing and Express middleware for FusionX VASP microservices.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "grpc": [
        "dist/grpc/index.d.ts"
      ],
      "constants": [
        "dist/constants/index.d.ts"
      ],
      "clients": [
        "dist/clients/index.d.ts"
      ],
      "logging": [
        "dist/logging/index.d.ts"
      ],
      "helpers": [
        "dist/helpers/index.d.ts"
      ],
      "middlewares": [
        "dist/middlewares/index.d.ts"
      ],
      "interfaces": [
        "dist/interfaces/index.d.ts"
      ],
      "exceptions": [
        "dist/exceptions/index.d.ts"
      ],
      "env": [
        "dist/env/index.d.ts"
      ],
      "runtime": [
        "dist/runtime/index.d.ts"
      ],
      "fastify": [
        "dist/fastify/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "eslint.base.mjs",
    "prettier.base.json",
    "tsconfig.base.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": "./eslint.base.mjs",
    "./prettier": "./prettier.base.json",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "default": "./dist/constants/index.js"
    },
    "./exceptions": {
      "types": "./dist/exceptions/index.d.ts",
      "default": "./dist/exceptions/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "default": "./dist/helpers/index.js"
    },
    "./middlewares": {
      "types": "./dist/middlewares/index.d.ts",
      "default": "./dist/middlewares/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "default": "./dist/interfaces/index.js"
    },
    "./clients": {
      "types": "./dist/clients/index.d.ts",
      "default": "./dist/clients/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "default": "./dist/logging/index.js"
    },
    "./grpc": {
      "types": "./dist/grpc/index.d.ts",
      "default": "./dist/grpc/index.js"
    },
    "./env": {
      "types": "./dist/env/index.d.ts",
      "default": "./dist/env/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify/index.d.ts",
      "default": "./dist/fastify/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest --passWithNoTests"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.test.ts"
    ]
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fusionxglobal/shared-config-module.git"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-ses": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@grpc/grpc-js": "^1.9.0",
    "@grpc/proto-loader": "^0.7.0 || ^0.8.0",
    "@opentelemetry/api": "^1.9.1",
    "axios": "^1.0.0",
    "express": "^5.0.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0 || ^6.0.0",
    "ioredis": "^5.0.0",
    "rabbitmq-with-retry-and-dlq": "^1.0.26",
    "sequelize": "^6.37.0",
    "winston": "^3.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@grpc/grpc-js": {
      "optional": true
    },
    "@grpc/proto-loader": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/client-ses": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "axios": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "rabbitmq-with-retry-and-dlq": {
      "optional": true
    },
    "sequelize": {
      "optional": true
    },
    "fastify": {
      "optional": "true"
    },
    "fastify-plugin": {
      "optional": "true"
    }
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "dotenv": "^17.2.3",
    "json-canonicalize": "^2.0.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.974.0",
    "@aws-sdk/client-ses": "^3.974.0",
    "@aws-sdk/s3-request-presigner": "^3.1009.0",
    "@eslint/js": "^9.39.2",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@opentelemetry/api": "^1.9.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.10",
    "axios": "^1.13.2",
    "eslint": "^9.39.2",
    "express": "^5.2.1",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.9.2",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "rabbitmq-with-retry-and-dlq": "^1.0.26",
    "rimraf": "^6.0.1",
    "sequelize": "^6.37.7",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "author": "FusionX Global",
  "license": "UNLICENSED",
  "private": false
}
